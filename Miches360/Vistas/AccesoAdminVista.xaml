<UserControl x:Class="Miches360.Vistas.AccesoAdminVista"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Miches360.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AccesoAdminViewModel}"
             d:DesignWidth="1366" d:DesignHeight="696"
             Focusable="True"
             PreviewKeyDown="AlPresionarTecla">

    <Border Width="440"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Padding="26,22" CornerRadius="22"
            Background="{StaticResource Encabezado}"
            BorderBrush="{StaticResource Borde}" BorderThickness="2">
        <StackPanel>
            <TextBlock Text="ACCESO DE ADMINISTRADOR" Style="{StaticResource Titulo}" FontSize="28"
                       Foreground="{StaticResource Acento}" />
            <TextBlock Margin="0,6,0,0" Text="Escribe tu PIN para entrar al catálogo y a los ajustes."
                       TextWrapping="Wrap" Style="{StaticResource EtiquetaSuave}" FontSize="15" />

            <Border Margin="0,16,0,0" Height="64" CornerRadius="14" Background="{StaticResource Fondo}">
                <TextBlock Text="{Binding PinMascara}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="34" FontWeight="Bold" />
            </Border>

            <TextBlock Margin="0,10,0,0" Text="{Binding ErrorAcceso}"
                       Foreground="{StaticResource RojoClaro}" FontSize="15" FontWeight="Bold"
                       TextWrapping="Wrap"
                       Visibility="{Binding ErrorAcceso, Converter={StaticResource ValorAVisibilidad}}" />

            <UniformGrid Margin="-4,12,-4,0" Columns="3" Rows="4">
                <Button Height="64" Content="1" Style="{StaticResource BotonTecla}" Command="{Binding TeclaCommand}" CommandParameter="1" />
                <Button Height="64" Content="2" Style="{StaticResource BotonTecla}" Command="{Binding TeclaCommand}" CommandParameter="2" />
                <Button Height="64" Content="3" Style="{StaticResource BotonTecla}" Command="{Binding TeclaCommand}" CommandParameter="3" />
                <Button Height="64" Content="4" Style="{StaticResource BotonTecla}" Command="{Binding TeclaCommand}" CommandParameter="4" />
                <Button Height="64" Content="5" Style="{StaticResource BotonTecla}" Command="{Binding TeclaCommand}" CommandParameter="5" />
                <Button Height="64" Content="6" Style="{StaticResource BotonTecla}" Command="{Binding TeclaCommand}" CommandParameter="6" />
                <Button Height="64" Content="7" Style="{StaticResource BotonTecla}" Command="{Binding TeclaCommand}" CommandParameter="7" />
                <Button Height="64" Content="8" Style="{StaticResource BotonTecla}" Command="{Binding TeclaCommand}" CommandParameter="8" />
                <Button Height="64" Content="9" Style="{StaticResource BotonTecla}" Command="{Binding TeclaCommand}" CommandParameter="9" />
                <Button Height="64" Content="Borrar" FontSize="16" Foreground="{StaticResource TextoSuave}"
                        Style="{StaticResource BotonTecla}" Command="{Binding BorrarPinCommand}" />
                <Button Height="64" Content="0" Style="{StaticResource BotonTecla}" Command="{Binding TeclaCommand}" CommandParameter="0" />
                <Button Height="64" Content="Entrar" FontSize="18" Margin="4"
                        Style="{StaticResource BotonAcento}" Command="{Binding EntrarCommand}" />
            </UniformGrid>

            <Border Margin="0,14,0,0" Padding="12,10" CornerRadius="12" Background="{StaticResource Chip}"
                    Visibility="{Binding PinEsInicial, Converter={StaticResource BoolAVisibilidad}}">
                <TextBlock TextWrapping="Wrap" FontSize="14" FontWeight="SemiBold">
                    <Run Text="PIN de fábrica:" />
                    <Run Text="{Binding PinInicial, Mode=OneWay}" FontWeight="ExtraBold" Foreground="{StaticResource Acento}" />
                    <Run Text="· cámbialo en Ajustes." />
                </TextBlock>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
