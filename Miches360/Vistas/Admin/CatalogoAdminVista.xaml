<UserControl x:Class="Miches360.Vistas.CatalogoAdminVista"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Miches360.ViewModels"
             xmlns:vistas="clr-namespace:Miches360.Vistas"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CatalogoAdminViewModel}"
             d:DesignWidth="1366" d:DesignHeight="696">

    <Grid>
        <Grid Visibility="{Binding Sesion.Activa, Converter={StaticResource BoolAVisibilidad}, ConverterParameter=invertir}">
            <vistas:AccesoAdminVista DataContext="{Binding Acceso}" />
        </Grid>

        <Grid Visibility="{Binding Sesion.Activa, Converter={StaticResource BoolAVisibilidad}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="20,14,20,10">
                <Button DockPanel.Dock="Right" Height="52" Padding="22,0"
                        Content="Bloquear" Style="{StaticResource BotonContorno}"
                        Command="{Binding BloquearCommand}" />

                <StackPanel Orientation="Horizontal">
                    <Button Height="52" Padding="24,0" Margin="0,0,8,0" Content="Productos"
                            Command="{Binding CambiarPestanaCommand}" CommandParameter="Productos">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BotonChip}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EsProductos}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Acento}" />
                                        <Setter Property="Foreground" Value="{StaticResource TextoSobreAcento}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Height="52" Padding="24,0" Margin="0,0,8,0" Content="Categorías"
                            Command="{Binding CambiarPestanaCommand}" CommandParameter="Categorias">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BotonChip}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EsCategorias}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Acento}" />
                                        <Setter Property="Foreground" Value="{StaticResource TextoSobreAcento}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Height="52" Padding="24,0" Content="Mesas"
                            Command="{Binding CambiarPestanaCommand}" CommandParameter="Mesas">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BotonChip}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EsMesas}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Acento}" />
                                        <Setter Property="Foreground" Value="{StaticResource TextoSobreAcento}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1">
                <vistas:ProductosAdminVista DataContext="{Binding Productos}"
                                            Visibility="{Binding DataContext.EsProductos, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolAVisibilidad}}" />
                <vistas:CategoriasAdminVista DataContext="{Binding Categorias}"
                                             Visibility="{Binding DataContext.EsCategorias, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolAVisibilidad}}" />
                <vistas:MesasAdminVista DataContext="{Binding Mesas}"
                                        Visibility="{Binding DataContext.EsMesas, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolAVisibilidad}}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
