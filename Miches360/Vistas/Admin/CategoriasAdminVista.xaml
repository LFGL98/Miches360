<UserControl x:Class="Miches360.Vistas.CategoriasAdminVista"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Miches360.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CategoriasAdminViewModel}"
             d:DesignWidth="1366" d:DesignHeight="620">

    <UserControl.Resources>
        <ItemsPanelTemplate x:Key="PanelEnvolvente">
            <WrapPanel />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <Grid Margin="20,0,20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="460" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Margin="0,0,14,0" CornerRadius="18" Background="{StaticResource Encabezado}" Padding="12">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="4,0,0,10">
                    <Button DockPanel.Dock="Right" Height="48" Padding="18,0"
                            Content="+ Nueva categoría"
                            Style="{StaticResource BotonContornoAcento}"
                            Command="{Binding NuevaCommand}" />
                    <TextBlock VerticalAlignment="Center"
                               Text="Las categorías ordenan los botones de la pantalla de venta"
                               Style="{StaticResource EtiquetaSuave}" FontSize="15" TextWrapping="Wrap" />
                </DockPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                    <ItemsControl ItemsSource="{Binding Categorias}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CategoriaAdminItem}">
                                <Button Command="{Binding DataContext.SeleccionarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource BotonFila}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EstaSeleccionada}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource Chip}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource Acento}" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Categoria.Activa}" Value="False">
                                                    <Setter Property="Opacity" Value="0.55" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="18" Height="18" CornerRadius="5" Margin="0,0,12,0"
                                                Background="{Binding Categoria.ColorHex}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Categoria.Nombre}" FontSize="17" FontWeight="Bold" />
                                            <TextBlock Text="{Binding Detalle}" Style="{StaticResource EtiquetaSuave}" FontSize="13" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="OCULTA"
                                                   FontSize="13" FontWeight="Bold" Foreground="{StaticResource RojoClaro}"
                                                   Visibility="{Binding Categoria.Activa, Converter={StaticResource BoolAVisibilidad}, ConverterParameter=invertir}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource Tarjeta}" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                <StackPanel Margin="22,20">
                    <TextBlock Text="{Binding TituloFormulario}" Style="{StaticResource Titulo}" FontSize="26"
                               Foreground="{StaticResource Acento}" />

                    <TextBlock Text="Nombre" Style="{StaticResource EtiquetaSuave}" Margin="0,14,0,6" />
                    <TextBox Style="{StaticResource CampoTexto}" MaxLength="60"
                             Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="¿Sus productos se venden por tamaño (chico, mediano, litro)?"
                               Style="{StaticResource EtiquetaSuave}" Margin="0,14,0,6" TextWrapping="Wrap" />
                    <UniformGrid Columns="2">
                        <Button Height="48" Margin="0,0,4,0" Content="Sí, con tamaños"
                                Command="{Binding FijarTamanosCommand}" CommandParameter="si">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BotonContorno}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ManejaTamanos}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Acento}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource Acento}" />
                                            <Setter Property="Foreground" Value="{StaticResource TextoSobreAcento}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Height="48" Margin="4,0,0,0" Content="No, precio único"
                                Command="{Binding FijarTamanosCommand}" CommandParameter="no">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BotonContorno}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ManejaTamanos}" Value="False">
                                            <Setter Property="Background" Value="{StaticResource Acento}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource Acento}" />
                                            <Setter Property="Foreground" Value="{StaticResource TextoSobreAcento}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </UniformGrid>

                    <TextBlock Text="Normalmente se prepara en" Style="{StaticResource EtiquetaSuave}" Margin="0,14,0,6" />
                    <ItemsControl ItemsSource="{Binding Estaciones}" ItemsPanel="{StaticResource PanelEnvolvente}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Texto}" Style="{StaticResource BotonOpcion}"
                                        Command="{Binding DataContext.ElegirEstacionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Color" Style="{StaticResource EtiquetaSuave}" Margin="0,6,0,6" />
                    <ItemsControl ItemsSource="{Binding Colores}" ItemsPanel="{StaticResource PanelEnvolvente}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource BotonColor}" ToolTip="{Binding Valor}"
                                        Command="{Binding DataContext.ElegirColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Margin="0,16,0,0" Height="60" FontSize="19"
                            Content="Guardar categoría"
                            Style="{StaticResource BotonVerde}"
                            Command="{Binding GuardarCommand}" />

                    <Button Margin="0,10,0,0" Height="50"
                            Content="{Binding TextoCambiarEstado}"
                            Style="{StaticResource BotonCancelarTicket}"
                            Command="{Binding CambiarEstadoCommand}"
                            Visibility="{Binding EsEdicion, Converter={StaticResource BoolAVisibilidad}}" />

                    <Button Margin="0,10,0,0" Height="50"
                            Content="{Binding TextoEliminar}"
                            Style="{StaticResource BotonEliminar}"
                            Command="{Binding EliminarCommand}"
                            Visibility="{Binding EsEdicion, Converter={StaticResource BoolAVisibilidad}}" />

                    <Border Style="{StaticResource Mensaje}"
                            Visibility="{Binding Mensaje, Converter={StaticResource ValorAVisibilidad}}">
                        <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
