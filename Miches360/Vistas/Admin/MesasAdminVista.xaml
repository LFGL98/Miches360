<UserControl x:Class="Miches360.Vistas.MesasAdminVista"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Miches360.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MesasAdminViewModel}"
             d:DesignWidth="1366" d:DesignHeight="620">

    <Grid Margin="20,0,20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Margin="0,0,14,0" CornerRadius="18" Background="{StaticResource Encabezado}" Padding="14">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="2,0,0,12">
                    <Button DockPanel.Dock="Right" Height="48" Padding="18,0"
                            Content="+ Nueva mesa"
                            Style="{StaticResource BotonContornoAcento}"
                            Command="{Binding NuevaCommand}" />
                    <TextBlock VerticalAlignment="Center"
                               Text="Toca una mesa para cambiarle el nombre, quitarla del mapa o eliminarla"
                               Style="{StaticResource EtiquetaSuave}" FontSize="15" />
                </DockPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                    <ItemsControl ItemsSource="{Binding Mesas}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:MesaAdminItem}">
                                <Button Width="150" Height="104" Margin="0,0,10,10"
                                        Command="{Binding DataContext.SeleccionarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource BotonBase}">
                                            <Setter Property="Background" Value="{StaticResource Tile}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EstaSeleccionada}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource Acento}" />
                                                    <Setter Property="BorderThickness" Value="3" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Mesa.Activa}" Value="False">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource Borde}" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                    <Setter Property="Foreground" Value="{StaticResource TextoSuave}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Mesa.Nombre}" FontSize="19" FontWeight="ExtraBold"
                                                   TextAlignment="Center" TextWrapping="Wrap" />
                                        <TextBlock Text="QUITADA" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource RojoClaro}"
                                                   Visibility="{Binding Mesa.Activa, Converter={StaticResource BoolAVisibilidad}, ConverterParameter=invertir}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource Tarjeta}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="{Binding TituloFormulario}" Style="{StaticResource Titulo}" FontSize="26"
                           Foreground="{StaticResource Acento}" />
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Style="{StaticResource EtiquetaSuave}" FontSize="14"
                           Text="Puede ser una mesa, la barra o una zona: Mesa 11, Barra 3, Terraza 1…" />

                <TextBlock Text="Nombre" Style="{StaticResource EtiquetaSuave}" Margin="0,14,0,6" />
                <TextBox Style="{StaticResource CampoTexto}" MaxLength="30"
                         Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" />

                <Button Margin="0,18,0,0" Height="60" FontSize="19"
                        Content="Guardar mesa"
                        Style="{StaticResource BotonVerde}"
                        Command="{Binding GuardarCommand}" />

                <Button Margin="0,10,0,0" Height="50"
                        Content="{Binding TextoCambiarEstado}"
                        Style="{StaticResource BotonCancelarTicket}"
                        Command="{Binding CambiarEstadoCommand}"
                        Visibility="{Binding EsEdicion, Converter={StaticResource BoolAVisibilidad}}" />

                <Button Margin="0,10,0,0" Height="50"
                        Content="{Binding TextoEliminar}"
                        Style="{StaticResource BotonEliminar}"
                        Command="{Binding EliminarCommand}"
                        Visibility="{Binding EsEdicion, Converter={StaticResource BoolAVisibilidad}}" />

                <Border Style="{StaticResource Mensaje}"
                        Visibility="{Binding Mensaje, Converter={StaticResource ValorAVisibilidad}}">
                    <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap" FontWeight="SemiBold" />
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
