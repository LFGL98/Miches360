<UserControl x:Class="Miches360.Vistas.ProductosAdminVista"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Miches360.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ProductosAdminViewModel}"
             d:DesignWidth="1366" d:DesignHeight="620">

    <UserControl.Resources>
        <ItemsPanelTemplate x:Key="PanelEnvolvente">
            <WrapPanel />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <Grid Margin="20,0,20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="440" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,14,0">
            <Button DockPanel.Dock="Bottom" Height="52" Margin="0,8,0,0"
                    Click="AlternarInactivos">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource BotonContorno}">
                        <Setter Property="Content" Value="Ver quitados" />
                        <Setter Property="FontSize" Value="14" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MostrarInactivos}" Value="True">
                                <Setter Property="Content" Value="Ocultar quitados" />
                                <Setter Property="BorderBrush" Value="{StaticResource Acento}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                <ItemsControl ItemsSource="{Binding Filtros}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Height="52" Margin="0,0,0,8"
                                    HorizontalContentAlignment="Left" Padding="14,0"
                                    Style="{StaticResource BotonOpcion}"
                                    Command="{Binding DataContext.FiltrarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="12" Height="12" CornerRadius="3" Margin="0,0,10,0"
                                            Background="{Binding ColorHex}" />
                                    <TextBlock Text="{Binding Texto}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <Border Grid.Column="1" Margin="0,0,14,0" CornerRadius="18" Background="{StaticResource Encabezado}" Padding="12">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="4,0,0,10">
                    <Button DockPanel.Dock="Right" Height="48" Padding="18,0"
                            Content="+ Nuevo producto"
                            Style="{StaticResource BotonContornoAcento}"
                            Command="{Binding NuevoCommand}" />
                    <TextBlock VerticalAlignment="Center" Text="Toca un producto para editarlo"
                               Style="{StaticResource EtiquetaSuave}" FontSize="15" />
                </DockPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                    <ItemsControl ItemsSource="{Binding Productos}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ProductoAdminItem}">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Margin="0"
                                            Command="{Binding DataContext.SeleccionarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource BotonFila}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EstaSeleccionado}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource Chip}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource Acento}" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Producto.Activo}" Value="False">
                                                        <Setter Property="Opacity" Value="0.55" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="16" Height="16" CornerRadius="4" Margin="0,0,12,0"
                                                    Background="{Binding Producto.ColorHex}" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Producto.Nombre}" FontSize="17" FontWeight="Bold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource EtiquetaSuave}" FontSize="13">
                                                    <Run Text="{Binding Producto.Categoria, Mode=OneWay}" />
                                                    <Run Text="{Binding Estado, Mode=OneWay}" Foreground="{StaticResource RojoClaro}" FontWeight="Bold" />
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0"
                                                       Text="{Binding TextoPrecios}" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Acento}" />
                                        </Grid>
                                    </Button>

                                    <Button Grid.Column="1" Width="112" Height="48" Margin="8,0,0,0"
                                            Command="{Binding DataContext.CambiarDisponibleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource BotonContorno}">
                                                <Setter Property="Content" Value="Disponible" />
                                                <Setter Property="FontSize" Value="14" />
                                                <Setter Property="BorderBrush" Value="{StaticResource Verde}" />
                                                <Setter Property="Foreground" Value="{StaticResource VerdeClaro}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Producto.Disponible}" Value="False">
                                                        <Setter Property="Content" Value="Agotado" />
                                                        <Setter Property="Background" Value="{StaticResource Rojo}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource Rojo}" />
                                                        <Setter Property="Foreground" Value="{StaticResource Blanco}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Tarjeta}" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                <StackPanel Margin="22,20">
                    <TextBlock Text="{Binding TituloFormulario}" Style="{StaticResource Titulo}" FontSize="26"
                               Foreground="{StaticResource Acento}" />

                    <TextBlock Text="Nombre" Style="{StaticResource EtiquetaSuave}" Margin="0,14,0,6" />
                    <TextBox Style="{StaticResource CampoTexto}" MaxLength="80"
                             Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Categoría" Style="{StaticResource EtiquetaSuave}" Margin="0,14,0,6" />
                    <ItemsControl ItemsSource="{Binding CategoriasFormulario}" ItemsPanel="{StaticResource PanelEnvolvente}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Texto}" Style="{StaticResource BotonOpcion}"
                                        Command="{Binding DataContext.ElegirCategoriaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Visibility="{Binding UsaPrecioUnico, Converter={StaticResource BoolAVisibilidad}}">
                        <TextBlock Text="Precio" Style="{StaticResource EtiquetaSuave}" Margin="0,8,0,6" />
                        <TextBox Style="{StaticResource CampoTexto}" Width="180" HorizontalAlignment="Left"
                                 InputScope="Number"
                                 Text="{Binding PrecioUnico, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding UsaTamanos, Converter={StaticResource BoolAVisibilidad}}">
                        <TextBlock Text="Precio por tamaño (deja vacío el que no vendas)" Style="{StaticResource EtiquetaSuave}" Margin="0,8,0,6" />
                        <UniformGrid Columns="3">
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="Chico" Style="{StaticResource EtiquetaSuave}" FontSize="13" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource CampoTexto}" InputScope="Number"
                                         Text="{Binding PrecioChico, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="3,0">
                                <TextBlock Text="Mediano" Style="{StaticResource EtiquetaSuave}" FontSize="13" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource CampoTexto}" InputScope="Number"
                                         Text="{Binding PrecioMediano, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="6,0,0,0">
                                <TextBlock Text="Litro" Style="{StaticResource EtiquetaSuave}" FontSize="13" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource CampoTexto}" InputScope="Number"
                                         Text="{Binding PrecioLitro, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>

                    <TextBlock Text="Se prepara en" Style="{StaticResource EtiquetaSuave}" Margin="0,14,0,6" />
                    <ItemsControl ItemsSource="{Binding Estaciones}" ItemsPanel="{StaticResource PanelEnvolvente}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Texto}" Style="{StaticResource BotonOpcion}"
                                        Command="{Binding DataContext.ElegirEstacionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Color del botón" Style="{StaticResource EtiquetaSuave}" Margin="0,6,0,6" />
                    <ItemsControl ItemsSource="{Binding Colores}" ItemsPanel="{StaticResource PanelEnvolvente}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource BotonColor}" ToolTip="{Binding Valor}"
                                        Command="{Binding DataContext.ElegirColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="¿Hay existencia?" Style="{StaticResource EtiquetaSuave}" Margin="0,6,0,6" />
                    <UniformGrid Columns="2">
                        <Button Height="48" Margin="0,0,4,0" Content="Disponible"
                                Command="{Binding FijarDisponibleCommand}" CommandParameter="si">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BotonContorno}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Disponible}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Verde}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource Verde}" />
                                            <Setter Property="Foreground" Value="{StaticResource Blanco}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Height="48" Margin="4,0,0,0" Content="Agotado"
                                Command="{Binding FijarDisponibleCommand}" CommandParameter="no">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BotonContorno}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Disponible}" Value="False">
                                            <Setter Property="Background" Value="{StaticResource Rojo}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource Rojo}" />
                                            <Setter Property="Foreground" Value="{StaticResource Blanco}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </UniformGrid>

                    <Button Margin="0,20,0,0" Height="60" FontSize="19"
                            Content="Guardar producto"
                            Style="{StaticResource BotonVerde}"
                            Command="{Binding GuardarCommand}" />

                    <Button Margin="0,10,0,0" Height="50"
                            Content="{Binding TextoCambiarActivo}"
                            Style="{StaticResource BotonCancelarTicket}"
                            Command="{Binding CambiarActivoCommand}"
                            Visibility="{Binding EsEdicion, Converter={StaticResource BoolAVisibilidad}}" />

                    <Button Margin="0,10,0,0" Height="50"
                            Content="{Binding TextoEliminar}"
                            Style="{StaticResource BotonEliminar}"
                            Command="{Binding EliminarCommand}"
                            Visibility="{Binding EsEdicion, Converter={StaticResource BoolAVisibilidad}}" />

                    <Border Style="{StaticResource Mensaje}"
                            Visibility="{Binding Mensaje, Converter={StaticResource ValorAVisibilidad}}">
                        <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
