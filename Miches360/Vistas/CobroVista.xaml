<UserControl x:Class="Miches360.Vistas.CobroVista"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Miches360.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CobroViewModel}"
             d:DesignWidth="1366" d:DesignHeight="696">

    <UserControl.Resources>
        <Style x:Key="BotonMetodo" TargetType="Button" BasedOn="{StaticResource BotonContorno}">
            <Setter Property="Height" Value="64" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="ExtraBold" />
        </Style>

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="BorderThickness" Value="3" />
            <Setter Property="Background" Value="{StaticResource PanelActivo}" />
            <Setter Property="BorderBrush" Value="{StaticResource Acento}" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                    <Setter Property="Background" Value="{StaticResource PanelInactivo}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Borde}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BotonBillete" TargetType="Button" BasedOn="{StaticResource BotonChip}">
            <Setter Property="Height" Value="52" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="ExtraBold" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource Ticket}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="20,18,20,12" BorderBrush="{StaticResource TicketLinea}" BorderThickness="0,0,0,1">
                    <TextBlock Text="{Binding Titulo}" Style="{StaticResource Titulo}" FontSize="26" TextWrapping="Wrap"
                               Foreground="{StaticResource TicketTexto}" />
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                    <ItemsControl Margin="20,4" ItemsSource="{Binding Lineas}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:LineaCobro}">
                                <Border Padding="0,12" BorderBrush="{StaticResource TicketLinea}" BorderThickness="0,0,0,1">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                                                   Text="{Binding Importe, StringFormat='{}{0:$#,0.##}'}"
                                                   FontSize="17" FontWeight="ExtraBold"
                                                   Foreground="{StaticResource TicketTexto}" />
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Texto}" TextWrapping="Wrap"
                                                       FontSize="17" FontWeight="ExtraBold"
                                                       Foreground="{StaticResource TicketTexto}" />
                                            <TextBlock Text="{Binding Detalle}" FontSize="14"
                                                       Foreground="{StaticResource TicketTextoSuave}"
                                                       Visibility="{Binding Detalle, Converter={StaticResource ValorAVisibilidad}}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="2" Padding="20,16,20,20" BorderBrush="{StaticResource TicketBotonBorde}" BorderThickness="0,2,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                                   FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource TicketTextoSuave}">
                            <Run Text="Total ·" />
                            <Run Text="{Binding Articulos, Mode=OneWay}" />
                            <Run Text="art." />
                        </TextBlock>
                        <TextBlock HorizontalAlignment="Right"
                                   Text="{Binding Total, StringFormat='{}{0:$#,0.##}'}"
                                   Style="{StaticResource Titulo}" FontSize="48"
                                   Foreground="{StaticResource TicketTexto}" />
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,14">
                <Button Margin="0,0,6,0" Content="Efectivo"
                        Command="{Binding SeleccionarMetodoCommand}" CommandParameter="Efectivo">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BotonMetodo}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EsEfectivo}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Acento}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource Acento}" />
                                    <Setter Property="Foreground" Value="{StaticResource TextoSobreAcento}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Margin="3,0" Content="Transferencia"
                        Command="{Binding SeleccionarMetodoCommand}" CommandParameter="Transferencia">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BotonMetodo}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EsTransferencia}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Acento}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource Acento}" />
                                    <Setter Property="Foreground" Value="{StaticResource TextoSobreAcento}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Margin="6,0,0,0" Content="Mixto (parte y parte)"
                        Command="{Binding SeleccionarMetodoCommand}" CommandParameter="Mixto">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BotonMetodo}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EsMixto}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Acento}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource Acento}" />
                                    <Setter Property="Foreground" Value="{StaticResource TextoSobreAcento}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </UniformGrid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Panel}" IsEnabled="{Binding PanelEfectivoActivo}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="EFECTIVO" Style="{StaticResource Titulo}" FontSize="24"
                                   Foreground="{StaticResource Acento}" />

                        <Border Grid.Row="1" Margin="0,10,0,8" Padding="14,6" CornerRadius="12" Background="{StaticResource Fondo}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                                           Text="{Binding TituloTeclado}"
                                           Style="{StaticResource EtiquetaSuave}" FontSize="15" />
                                <TextBlock HorizontalAlignment="Right"
                                           Text="{Binding MontoTeclado, StringFormat='{}{0:$#,0.##}'}"
                                           Style="{StaticResource Titulo}" FontSize="40" />
                            </DockPanel>
                        </Border>

                        <UniformGrid Grid.Row="2" Columns="5" Margin="-3,0,-3,4">
                            <Button Content="Exacto" Style="{StaticResource BotonBillete}"
                                    Command="{Binding BilleteCommand}" CommandParameter="exacto" />
                            <Button Content="$500" Style="{StaticResource BotonBillete}"
                                    Command="{Binding BilleteCommand}" CommandParameter="500" />
                            <Button Content="$200" Style="{StaticResource BotonBillete}"
                                    Command="{Binding BilleteCommand}" CommandParameter="200" />
                            <Button Content="$100" Style="{StaticResource BotonBillete}"
                                    Command="{Binding BilleteCommand}" CommandParameter="100" />
                            <Button Content="$50" Style="{StaticResource BotonBillete}"
                                    Command="{Binding BilleteCommand}" CommandParameter="50" />
                        </UniformGrid>

                        <UniformGrid Grid.Row="3" Columns="3" Rows="4" Margin="-4,0">
                            <Button Content="1" Style="{StaticResource BotonTecla}" Command="{Binding TeclaCommand}" CommandParameter="1" />
                            <Button Content="2" Style="{StaticResource BotonTecla}" Command="{Binding TeclaCommand}" CommandParameter="2" />
                            <Button Content="3" Style="{StaticResource BotonTecla}" Command="{Binding TeclaCommand}" CommandParameter="3" />
                            <Button Content="4" Style="{StaticResource BotonTecla}" Command="{Binding TeclaCommand}" CommandParameter="4" />
                            <Button Content="5" Style="{StaticResource BotonTecla}" Command="{Binding TeclaCommand}" CommandParameter="5" />
                            <Button Content="6" Style="{StaticResource BotonTecla}" Command="{Binding TeclaCommand}" CommandParameter="6" />
                            <Button Content="7" Style="{StaticResource BotonTecla}" Command="{Binding TeclaCommand}" CommandParameter="7" />
                            <Button Content="8" Style="{StaticResource BotonTecla}" Command="{Binding TeclaCommand}" CommandParameter="8" />
                            <Button Content="9" Style="{StaticResource BotonTecla}" Command="{Binding TeclaCommand}" CommandParameter="9" />
                            <Button Content="Borrar" Style="{StaticResource BotonTecla}" FontSize="16"
                                    Foreground="{StaticResource TextoSuave}" Command="{Binding BorrarCommand}" />
                            <Button Content="0" Style="{StaticResource BotonTecla}" Command="{Binding TeclaCommand}" CommandParameter="0" />
                            <Button Content="00" Style="{StaticResource BotonTecla}" Command="{Binding TeclaCommand}" CommandParameter="00" />
                        </UniformGrid>

                        <Border Grid.Row="4" Margin="0,8,0,0" Padding="14,10" CornerRadius="12">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource Chip}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ResultadoEfectivoOk}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Verde}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ResultadoEfectivo}"
                                       Foreground="{StaticResource Blanco}"
                                       FontSize="20" FontWeight="ExtraBold"
                                       TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Panel}" IsEnabled="{Binding PanelTransferenciaActivo}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                                       Text="{Binding MontoTransferencia, StringFormat='{}{0:$#,0.##}'}"
                                       Style="{StaticResource Titulo}" FontSize="30"
                                       Foreground="{StaticResource AzulClaro}" />
                            <TextBlock Text="TRANSFERENCIA" Style="{StaticResource Titulo}" FontSize="24" />
                        </DockPanel>

                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="140" Height="140" CornerRadius="14"
                                    Background="{StaticResource Ticket}" Padding="10">
                                <TextBlock Text="[QR de cobro de tu banco]"
                                           TextAlignment="Center" TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource TicketTextoSuave}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0"
                                        Visibility="{Binding HayDatosTransferencia, Converter={StaticResource BoolAVisibilidad}}">
                                <TextBlock Text="Banco" Style="{StaticResource EtiquetaSuave}" />
                                <TextBlock Text="{Binding Banco}" FontSize="16" FontWeight="ExtraBold" Margin="0,0,0,6" />
                                <TextBlock Text="CLABE / tarjeta" Style="{StaticResource EtiquetaSuave}" />
                                <TextBlock Text="{Binding Clabe}" FontSize="16" FontWeight="ExtraBold" Margin="0,0,0,6" />
                                <TextBlock Text="A nombre de" Style="{StaticResource EtiquetaSuave}" />
                                <TextBlock Text="{Binding Titular}" FontSize="16" FontWeight="ExtraBold" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Column="1" Margin="14,0,0,0" Padding="12" CornerRadius="12"
                                    VerticalAlignment="Top"
                                    Background="{StaticResource Chip}"
                                    Visibility="{Binding HayDatosTransferencia, Converter={StaticResource BoolAVisibilidad}, ConverterParameter=invertir}">
                                <TextBlock TextWrapping="Wrap" FontSize="15" FontWeight="SemiBold"
                                           Text="Aún no hay banco ni CLABE. El administrador los captura en Ajustes." />
                            </Border>
                        </Grid>

                        <DockPanel Grid.Row="2" Margin="0,12,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="Concepto:" Style="{StaticResource EtiquetaSuave}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding Concepto}" FontSize="17" FontWeight="ExtraBold"
                                       Foreground="{StaticResource Acento}" />
                        </DockPanel>

                        <StackPanel Grid.Row="3" Margin="0,12,0,0">
                            <TextBlock Text="Folio de rastreo o últimos 4 dígitos (opcional)"
                                       Style="{StaticResource EtiquetaSuave}" Margin="0,0,0,6" />
                            <TextBox Style="{StaticResource CampoTexto}"
                                     Text="{Binding Referencia, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <TextBlock Grid.Row="4" Margin="0,12,0,0" VerticalAlignment="Bottom"
                                   Text="Confirma solo cuando veas el depósito en la app de tu banco."
                                   TextWrapping="Wrap" Style="{StaticResource EtiquetaSuave}" />

                        <Button Grid.Row="5" Margin="0,10,0,0" Height="60"
                                Content="{Binding TextoConfirmarTransferencia}"
                                Command="{Binding ConfirmarTransferenciaCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BotonContorno}">
                                    <Setter Property="BorderBrush" Value="{StaticResource Azul}" />
                                    <Setter Property="Foreground" Value="{StaticResource AzulClaro}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TransferenciaConfirmada}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Azul}" />
                                            <Setter Property="Foreground" Value="{StaticResource Blanco}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Margin="0,12,0,0" Padding="16,12" CornerRadius="12"
                    Background="{StaticResource Rojo}"
                    Visibility="{Binding MensajeError, Converter={StaticResource ValorAVisibilidad}}">
                <TextBlock Text="{Binding MensajeError}" TextWrapping="Wrap" FontWeight="SemiBold" />
            </Border>

            <Grid Grid.Row="3" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Height="76" Padding="28,0" Margin="0,0,12,0"
                        Content="Volver" FontSize="18"
                        Style="{StaticResource BotonContorno}"
                        Command="{Binding VolverCommand}" />
                <Button Grid.Column="1" Height="76"
                        Content="{Binding TextoBotonCobrar}" FontSize="22"
                        Style="{StaticResource BotonVerde}"
                        Command="{Binding CobrarCommand}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
