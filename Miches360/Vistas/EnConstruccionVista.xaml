<UserControl x:Class="Miches360.Vistas.EnConstruccionVista"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Miches360.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:EnConstruccionViewModel}"
             d:DesignWidth="1366" d:DesignHeight="696">

    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
            MaxWidth="720" Padding="36,30" CornerRadius="22"
            Background="{StaticResource Encabezado}"
            BorderBrush="{StaticResource Borde}" BorderThickness="2">
        <StackPanel>
            <TextBlock Text="{Binding Titulo}" Style="{StaticResource Titulo}" FontSize="40"
                       Foreground="{StaticResource Acento}" />
            <TextBlock Margin="0,12,0,0" Text="{Binding Descripcion}"
                       TextWrapping="Wrap" FontSize="19" LineHeight="28" />
        </StackPanel>
    </Border>
</UserControl>
