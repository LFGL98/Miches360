<UserControl x:Class="Miches360.Vistas.HistorialVista"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Miches360.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HistorialViewModel}"
             d:DesignWidth="1366" d:DesignHeight="696">

    <UserControl.Resources>
        <Style x:Key="CampoPin" TargetType="PasswordBox">
            <Setter Property="Height" Value="52" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource Fondo}" />
            <Setter Property="Foreground" Value="{StaticResource Texto}" />
            <Setter Property="CaretBrush" Value="{StaticResource Texto}" />
            <Setter Property="BorderBrush" Value="{StaticResource Borde}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="MaxLength" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotonRojo" TargetType="Button" BasedOn="{StaticResource BotonBase}">
            <Setter Property="Background" Value="{StaticResource Rojo}" />
            <Setter Property="Foreground" Value="{StaticResource Blanco}" />
            <Setter Property="FontWeight" Value="ExtraBold" />
        </Style>

        <Style x:Key="BotonContornoRojo" TargetType="Button" BasedOn="{StaticResource BotonBase}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource Rojo}" />
            <Setter Property="Foreground" Value="{StaticResource RojoClaro}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="FontWeight" Value="ExtraBold" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="18,14,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Width="52" Height="52" Content="‹" FontSize="26"
                        Style="{StaticResource BotonContorno}" Command="{Binding AnteriorCommand}" />
                <TextBlock MinWidth="330" Margin="12,0" VerticalAlignment="Center" TextAlignment="Center"
                           Text="{Binding TextoDia}" Style="{StaticResource Titulo}" FontSize="23" />
                <Button Width="52" Height="52" Content="›" FontSize="26" Margin="0,0,8,0"
                        Style="{StaticResource BotonContorno}" Command="{Binding SiguienteCommand}" />
                <Button Height="52" Padding="18,0" Margin="0,0,8,0" Content="Hoy"
                        Style="{StaticResource BotonContornoAcento}" Command="{Binding HoyCommand}" />
                <Button Width="52" Height="52" Content="↻" FontSize="22" ToolTip="Actualizar"
                        Style="{StaticResource BotonContorno}" Command="{Binding ActualizarCommand}" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Filtros}" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Height="52" Margin="8,0,0,0" Padding="18,0" Content="{Binding Texto}"
                                Style="{StaticResource BotonOpcion}"
                                Command="{Binding DataContext.FiltrarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <TextBlock Grid.Row="1" Margin="2,12,0,10" Text="{Binding Resumen}" Style="{StaticResource EtiquetaSuave}" FontSize="16" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="460" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,0,14,0" CornerRadius="18" Background="{StaticResource Encabezado}" Padding="12">
                <Grid>
                    <TextBlock Margin="10" Text="No hay ventas en este día." Style="{StaticResource EtiquetaSuave}" FontSize="16"
                               Visibility="{Binding Ventas.Count, Converter={StaticResource ValorAVisibilidad}, ConverterParameter=invertir}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                        <ItemsControl ItemsSource="{Binding Ventas}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:VentaHistorialItem}">
                                    <Button Command="{Binding DataContext.SeleccionarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource BotonFila}">
                                                <Setter Property="Background" Value="{StaticResource Tile}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource Tile}" />
                                                <Setter Property="BorderThickness" Value="2" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EstaSeleccionada}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource Acento}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="86" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Folio}" FontSize="18" FontWeight="ExtraBold" />
                                                <TextBlock Text="{Binding Hora}" Style="{StaticResource EtiquetaSuave}" FontSize="13" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Venta.Origen}" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detalle}" Style="{StaticResource EtiquetaSuave}" FontSize="13"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Border Grid.Column="2" VerticalAlignment="Center" Padding="10,4" CornerRadius="8"
                                                    BorderThickness="2" BorderBrush="{Binding ColorEstado}">
                                                <TextBlock Text="{Binding Estado}" FontSize="12" FontWeight="ExtraBold" Foreground="{Binding ColorEstado}" />
                                            </Border>
                                            <TextBlock Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                       Text="{Binding TextoTotal}" FontSize="19" FontWeight="ExtraBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EsCancelada}" Value="True">
                                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                <Setter Property="Foreground" Value="{StaticResource TextoSuave}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1" CornerRadius="18" Background="{StaticResource Encabezado}" Padding="16">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20"
                                Visibility="{Binding HaySeleccion, Converter={StaticResource BoolAVisibilidad}, ConverterParameter=invertir}">
                        <TextBlock Text="Toca una venta" Style="{StaticResource Titulo}" FontSize="26" HorizontalAlignment="Center" />
                        <TextBlock Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource EtiquetaSuave}" FontSize="15"
                                   Text="Verás su ticket, podrás reimprimirlo o cancelar la venta con el PIN de administrador." />
                    </StackPanel>

                    <Grid Visibility="{Binding HaySeleccion, Converter={StaticResource BoolAVisibilidad}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                            <Border HorizontalAlignment="Center" Margin="0,4,0,8" Padding="14,16,14,4" Background="White" CornerRadius="6">
                                <ContentControl Focusable="False"
                                                Content="{Binding VistaPrevia, Converter={StaticResource VistaPreviaTicket}}">
                                    <ContentControl.LayoutTransform>
                                        <ScaleTransform ScaleX="1.15" ScaleY="1.15" />
                                    </ContentControl.LayoutTransform>
                                </ContentControl>
                            </Border>
                        </ScrollViewer>

                        <StackPanel Grid.Row="1">
                            <Border Margin="0,0,0,10" Style="{StaticResource Mensaje}"
                                    Visibility="{Binding Mensaje, Converter={StaticResource ValorAVisibilidad}}">
                                <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap" FontWeight="SemiBold" />
                            </Border>

                            <UniformGrid Columns="2"
                                         Visibility="{Binding MostrarCancelacion, Converter={StaticResource BoolAVisibilidad}, ConverterParameter=invertir}">
                                <Button Height="62" Margin="0,0,6,0" FontSize="17" Content="Reimprimir ticket"
                                        Style="{StaticResource BotonAcento}" Command="{Binding ReimprimirCommand}" />
                                <Button Height="62" Margin="6,0,0,0" FontSize="17" Content="Cancelar venta"
                                        Style="{StaticResource BotonContornoRojo}" Command="{Binding IniciarCancelacionCommand}" />
                            </UniformGrid>

                            <Border Padding="14" CornerRadius="14" BorderThickness="2" BorderBrush="{StaticResource Rojo}"
                                    Background="{StaticResource Fondo}"
                                    Visibility="{Binding MostrarCancelacion, Converter={StaticResource BoolAVisibilidad}}">
                                <StackPanel>
                                    <TextBlock Text="Cancelar venta" Style="{StaticResource Titulo}" FontSize="22" Foreground="{StaticResource RojoClaro}" />
                                    <TextBlock Margin="0,2,0,10" TextWrapping="Wrap" Style="{StaticResource EtiquetaSuave}" FontSize="13"
                                               Text="Lo cobrado deja de contar en el corte: devuelve el dinero al cliente." />

                                    <ItemsControl ItemsSource="{Binding MotivosRapidos}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Height="42" Margin="0,0,6,6" Padding="12,0" FontSize="14" Content="{Binding}"
                                                        Style="{StaticResource BotonChip}"
                                                        Command="{Binding DataContext.ElegirMotivoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="Motivo" Style="{StaticResource EtiquetaSuave}" Margin="0,4,0,4" />
                                    <TextBox Style="{StaticResource CampoTexto}" MaxLength="120"
                                             Text="{Binding Motivo, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Text="PIN de administrador" Style="{StaticResource EtiquetaSuave}" Margin="0,10,0,4" />
                                    <PasswordBox x:Name="CampoPin" Style="{StaticResource CampoPin}" PasswordChanged="AlCambiarPin" />

                                    <UniformGrid Columns="2" Margin="0,12,0,0">
                                        <Button Height="58" Margin="0,0,6,0" Content="No cancelar"
                                                Style="{StaticResource BotonContorno}" Command="{Binding AbandonarCancelacionCommand}" />
                                        <Button Height="58" Margin="6,0,0,0" Content="Cancelar venta"
                                                Style="{StaticResource BotonRojo}" Command="{Binding ConfirmarCancelacionCommand}" />
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
