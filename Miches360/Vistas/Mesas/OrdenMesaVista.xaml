<UserControl x:Class="Miches360.Vistas.OrdenMesaVista"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Miches360.ViewModels"
             xmlns:vistas="clr-namespace:Miches360.Vistas"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:OrdenMesaViewModel}"
             d:DesignWidth="1366" d:DesignHeight="696">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Encabezado}" BorderBrush="{StaticResource Borde}" BorderThickness="0,0,0,1"
                Padding="16,10">
            <DockPanel>
                <Button DockPanel.Dock="Left" Height="52" Padding="18,0" Margin="0,0,14,0"
                        Content="‹ Volver" Style="{StaticResource BotonContorno}"
                        Command="{Binding VolverCommand}" />
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,18,0"
                           Text="{Binding Titulo}" Style="{StaticResource Titulo}" FontSize="24" />

                <Button DockPanel.Dock="Right" Height="52" Padding="18,0"
                        Content="+ Persona" Style="{StaticResource BotonContornoAcento}"
                        Command="{Binding AgregarPersonaCommand}" />

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding EsSeparada, Converter={StaticResource BoolAVisibilidad}}">
                    <TextBlock Text="Para:" VerticalAlignment="Center" Margin="0,0,10,0"
                               Style="{StaticResource EtiquetaSuave}" FontSize="16" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly">
                        <ItemsControl ItemsSource="{Binding Personas}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Height="52" Margin="0,0,8,0" Padding="16,0" FontSize="16"
                                            Content="{Binding Texto}" Style="{StaticResource BotonOpcion}"
                                            Command="{Binding DataContext.ElegirPersonaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="390" />
            </Grid.ColumnDefinitions>

            <vistas:SelectorProductosVista Grid.Column="0" DataContext="{Binding Selector}" />

            <Border Grid.Column="1" Background="{StaticResource Ticket}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="20,16,20,12" BorderBrush="{StaticResource TicketLinea}" BorderThickness="0,0,0,1">
                        <TextBlock Text="POR ENVIAR" Style="{StaticResource Titulo}" FontSize="24"
                                   Foreground="{StaticResource TicketTexto}" />
                    </Border>

                    <Grid Grid.Row="1">
                        <TextBlock Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" FontSize="16"
                                   Foreground="{StaticResource TicketTextoSuave}"
                                   Text="Elige a quién va arriba y toca los productos"
                                   Visibility="{Binding Lineas.Count, Converter={StaticResource ValorAVisibilidad}, ConverterParameter=invertir}" />

                        <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                            <ItemsControl Margin="20,4" ItemsSource="{Binding Lineas}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:LineaOrden}">
                                        <Border Padding="0,10" BorderBrush="{StaticResource TicketLinea}" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="34" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="68" />
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Margin="0,0,8,0" Padding="0" MinHeight="0"
                                                        HorizontalContentAlignment="Stretch" Background="Transparent"
                                                        Style="{StaticResource BotonBase}"
                                                        Command="{Binding DataContext.EditarNotaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Nombre}" TextWrapping="Wrap" FontSize="16" FontWeight="ExtraBold"
                                                                   Foreground="{StaticResource TicketTexto}" />
                                                        <TextBlock Text="{Binding Detalle}" FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TicketTextoSuave}" />
                                                        <TextBlock Text="{Binding TextoNota}" FontSize="13" TextWrapping="Wrap">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource TicketTextoSuave}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding TieneNota}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource Rojo}" />
                                                                            <Setter Property="FontWeight" Value="Bold" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Button>
                                                <Button Grid.Column="1" Content="−" Style="{StaticResource BotonTicket}"
                                                        Command="{Binding DataContext.DecrementarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Cantidad}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           FontSize="18" FontWeight="ExtraBold" Foreground="{StaticResource TicketTexto}" />
                                                <Button Grid.Column="3" Content="+" Style="{StaticResource BotonTicket}"
                                                        Command="{Binding DataContext.IncrementarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                <TextBlock Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           Text="{Binding Importe, StringFormat='{}{0:$#,0.##}'}"
                                                           FontSize="17" FontWeight="ExtraBold" Foreground="{StaticResource TicketTexto}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <Border Grid.Row="2" Padding="20,14,20,20" BorderBrush="{StaticResource TicketBotonBorde}" BorderThickness="0,2,0,0">
                        <StackPanel>
                            <Border Margin="0,0,0,12" Style="{StaticResource Mensaje}"
                                    Visibility="{Binding Mensaje, Converter={StaticResource ValorAVisibilidad}}">
                                <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap" FontWeight="SemiBold"
                                           Foreground="{StaticResource Blanco}" />
                            </Border>
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold"
                                           Foreground="{StaticResource TicketTextoSuave}">
                                    <Run Text="{Binding Articulos, Mode=OneWay}" />
                                    <Run Text="productos" />
                                </TextBlock>
                                <TextBlock HorizontalAlignment="Right"
                                           Text="{Binding Total, StringFormat='{}{0:$#,0.##}'}"
                                           Style="{StaticResource Titulo}" FontSize="42" Foreground="{StaticResource TicketTexto}" />
                            </DockPanel>
                            <Button Height="76" Content="Enviar orden" FontSize="22"
                                    Style="{StaticResource BotonVerde}" Command="{Binding EnviarCommand}" />
                        </StackPanel>
                    </Border>

                    <vistas:EditorNotaVista Grid.RowSpan="3" DataContext="{Binding EditorNota}"
                                            Visibility="{Binding Abierto, Converter={StaticResource BoolAVisibilidad}}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
