<UserControl x:Class="Miches360.Vistas.PartesIgualesVista"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Miches360.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PartesIgualesViewModel}"
             d:DesignWidth="1366" d:DesignHeight="696">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource Encabezado}" BorderBrush="{StaticResource Borde}" BorderThickness="0,0,0,1"
                    Padding="16,10">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Height="52" Padding="18,0" Margin="0,0,14,0"
                            Content="‹ Cuenta" Style="{StaticResource BotonContorno}"
                            Command="{Binding VolverCommand}" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding Titulo}" Style="{StaticResource Titulo}" FontSize="24" />
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Margin="18,12,18,0" Style="{StaticResource Mensaje}"
                    Visibility="{Binding Mensaje, Converter={StaticResource ValorAVisibilidad}}">
                <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="15" />
            </Border>

            <ScrollViewer Grid.Row="2" Margin="18,12,6,12" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                <ItemsControl ItemsSource="{Binding Partes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ParteItem}">
                            <Border Width="270" Margin="0,0,12,12" Padding="16,14" CornerRadius="18" BorderThickness="2">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource Ticket}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource Ticket}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Pagada}" Value="True">
                                                <Setter Property="Background" Value="#E4EDE2" />
                                                <Setter Property="BorderBrush" Value="#C7D8C5" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Text="{Binding TextoEstado}"
                                                   FontSize="11" FontWeight="ExtraBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TicketTextoSuave}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Pagada}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Verde}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Titulo}" Style="{StaticResource Titulo}" FontSize="20"
                                                   Foreground="{StaticResource TicketTextoSuave}" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Monto, StringFormat='{}{0:$#,0.00}'}" Style="{StaticResource Titulo}" FontSize="40"
                                               Foreground="{StaticResource TicketTexto}" />

                                    <UniformGrid Columns="2" Margin="0,8,0,0"
                                                 Visibility="{Binding Pendiente, Converter={StaticResource BoolAVisibilidad}}">
                                        <Button Height="60" Margin="0,0,4,0" FontSize="16" Content="Efectivo" Style="{StaticResource BotonVerde}"
                                                Command="{Binding DataContext.PagarEfectivoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Height="60" Margin="4,0,0,0" FontSize="16" Content="Transferencia" Style="{StaticResource BotonAzul}"
                                                Command="{Binding DataContext.PagarTransferenciaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </UniformGrid>

                                    <StackPanel Margin="0,8,0,0" Visibility="{Binding EsEfectivo, Converter={StaticResource BoolAVisibilidad}}">
                                        <ItemsControl ItemsSource="{Binding Billetes}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:BilleteParte}">
                                                    <Button Content="{Binding Texto}" Height="42" Padding="12,0" FontSize="14"
                                                            Style="{StaticResource BotonChipTicket}"
                                                            Command="{Binding DataContext.FijarRecibidoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding TextoCambio}" FontSize="15" FontWeight="ExtraBold" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TicketTexto}" />
                                    </StackPanel>

                                    <Button Margin="0,10,0,0" Height="44" Content="Deshacer" FontSize="14"
                                            Style="{StaticResource BotonChipTicket}"
                                            Command="{Binding DataContext.DeshacerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding Pagada, Converter={StaticResource BoolAVisibilidad}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Border Grid.Column="1" Background="{StaticResource Encabezado}" BorderBrush="{StaticResource Borde}" BorderThickness="1,0,0,0"
                Padding="22,20">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Margin="0,0,0,10" Text="{Binding TextoAvance}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" />
                    <Button Height="76" FontSize="21" Content="Registrar cobro"
                            Style="{StaticResource BotonVerde}" Command="{Binding RegistrarCobroCommand}" />
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="PENDIENTE DE LA MESA" Style="{StaticResource EtiquetaSuave}" FontSize="13" />
                    <TextBlock Text="{Binding Total, StringFormat='{}{0:$#,0.##}'}" Style="{StaticResource Titulo}" FontSize="52"
                               Foreground="{StaticResource Acento}" />

                    <TextBlock Margin="0,18,0,8" Text="¿Entre cuántos?" FontSize="17" FontWeight="Bold" />
                    <StackPanel Orientation="Horizontal">
                        <Button Width="64" Height="64" Content="−" FontSize="28" Style="{StaticResource BotonChip}"
                                Command="{Binding MenosPartesCommand}" />
                        <TextBlock Width="80" TextAlignment="Center" VerticalAlignment="Center"
                                   Text="{Binding NumeroPartes}" Style="{StaticResource Titulo}" FontSize="44" />
                        <Button Width="64" Height="64" Content="+" FontSize="28" Style="{StaticResource BotonChip}"
                                Command="{Binding MasPartesCommand}" />
                    </StackPanel>
                    <TextBlock Margin="0,10,0,0" Text="{Binding TextoPorParte}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{StaticResource TextoSuave}" />

                    <Border Margin="0,22,0,0" Padding="14,10" CornerRadius="12" Background="{StaticResource Chip}"
                            Visibility="{Binding DatosTransferencia, Converter={StaticResource ValorAVisibilidad}}">
                        <StackPanel>
                            <TextBlock Text="TRANSFERENCIAS A" Style="{StaticResource EtiquetaSuave}" FontSize="12" />
                            <TextBlock Text="{Binding DatosTransferencia}" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="0,18,0,0" TextWrapping="Wrap" Style="{StaticResource EtiquetaSuave}" FontSize="14"
                               Text="Marca cada parte cuando pague. Al final se registra un solo cobro con todos los pagos." />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
