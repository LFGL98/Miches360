<UserControl x:Class="Miches360.Vistas.SelectorProductosVista"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Miches360.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SelectorProductosViewModel}"
             d:DesignWidth="976" d:DesignHeight="696">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource Riel}">
            <ScrollViewer VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                <ItemsControl Margin="12,16" ItemsSource="{Binding Categorias}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CategoriaItem}">
                            <Button Height="96"
                                    Margin="0,0,0,10"
                                    Padding="8"
                                    Command="{Binding DataContext.SeleccionarCategoriaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource BotonChip}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EstaSeleccionada}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource Acento}" />
                                                <Setter Property="Foreground" Value="{StaticResource TextoSobreAcento}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel>
                                    <Border Width="28" Height="6" CornerRadius="3"
                                            Margin="0,0,0,8"
                                            Background="{Binding ColorHex}" />
                                    <TextBlock Text="{Binding Nombre}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               FontSize="16" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Grid Grid.Column="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,14" MinHeight="48" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            Visibility="{Binding MostrarTamanos, Converter={StaticResource BoolAVisibilidad}}">
                    <TextBlock Text="Tamaño:"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               Style="{StaticResource EtiquetaSuave}"
                               FontSize="16" />
                    <ItemsControl ItemsSource="{Binding Tamanos}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:OpcionTamano}">
                                <Button Height="48"
                                        MinWidth="110"
                                        Margin="0,0,10,0"
                                        Content="{Binding Texto}"
                                        Command="{Binding DataContext.SeleccionarTamanoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource BotonContorno}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EstaSeleccionado}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource Acento}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource Acento}" />
                                                    <Setter Property="Foreground" Value="{StaticResource TextoSobreAcento}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           Text="1 toque = 1 producto"
                           Style="{StaticResource EtiquetaSuave}" />
            </DockPanel>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          PanningMode="VerticalOnly">
                <ItemsControl ItemsSource="{Binding Productos}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" VerticalAlignment="Top" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ProductoItem}">
                            <Button Height="140"
                                    Margin="0,0,12,12"
                                    Padding="16,14"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Style="{StaticResource BotonBase}"
                                    IsEnabled="{Binding Habilitado}"
                                    Command="{Binding DataContext.ElegirProductoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Width="36" Height="8" CornerRadius="4"
                                            HorizontalAlignment="Left"
                                            Background="{Binding ColorHex}" />
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Nombre}"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               FontSize="19"
                                               FontWeight="ExtraBold" />
                                    <TextBlock Grid.Row="2"
                                               Text="{Binding TextoPrecio}"
                                               FontSize="21"
                                               FontWeight="ExtraBold"
                                               Foreground="{StaticResource Acento}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Grid.Row="2">
                <TextBlock Text="Cargando catálogo…"
                           Margin="0,8,0,0"
                           Style="{StaticResource EtiquetaSuave}"
                           Visibility="{Binding Cargando, Converter={StaticResource BoolAVisibilidad}}" />

                <Border Margin="0,8,0,0" Padding="16,12" CornerRadius="12"
                        Background="{StaticResource Rojo}"
                        Visibility="{Binding MensajeError, Converter={StaticResource ValorAVisibilidad}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Height="44" Padding="16,0"
                                Content="Reintentar"
                                Style="{StaticResource BotonContorno}"
                                BorderBrush="{StaticResource Texto}"
                                Command="{Binding RecargarCatalogoCommand}" />
                        <TextBlock Text="{Binding MensajeError}" TextWrapping="Wrap"
                                   VerticalAlignment="Center" FontWeight="SemiBold" />
                    </DockPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
