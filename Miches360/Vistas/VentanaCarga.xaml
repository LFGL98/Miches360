<Window x:Class="Miches360.Vistas.VentanaCarga"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controles="clr-namespace:Miches360.Controles"
        Title="Miches 360"
        Icon="/Assets/logo.png"
        Width="440" Height="500"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{StaticResource Fondo}"
        ShowInTaskbar="True"
        Topmost="False"
        WindowStartupLocation="CenterScreen">

    <Border BorderBrush="{StaticResource Acento}" BorderThickness="2">
        <Grid>
            <controles:CargandoMiches Tamano="320" Texto="Preparando la barra" />
        </Grid>
    </Border>
</Window>
